#!/usr/bin/env bash
# Displays DNS record type and destination for subdomains of a domain
dns_info() {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v s="$2" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ -z "$2" ]; then
    for sub in www lb-01 web-01 web-02; do
        dns_info "$1" "$sub"
    done
else
    dns_info "$1" "$2"
fi
