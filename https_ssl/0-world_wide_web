#!/usr/bin/env bash
# Displays DNS record information for the subdomains of a domain

audit_subdomain () {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -n 1 | \
        awk -v sub_domain="$2" '{print "The subdomain " sub_domain " is a " $4 " record and points to " $5}'
}

if [ "$#" -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        audit_subdomain "$1" "$sub"
    done
else
    audit_subdomain "$1" "$2"
fi
